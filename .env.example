# Copy to .env and fill in. Source of truth: src/env.ts.
# Variables with a built-in default are commented out. Uncomment one to override it.
# An empty value is not the same as unset: leave defaulted variables commented out.

# --- Required (the server will not start without these) ---

# Postgres connection string. TLS is always on, so use a hosted Postgres such as Neon.
DATABASE_URL=
# Random string used to sign session cookies (for example: openssl rand -hex 32).
SESSION_SECRET=
# Anthropic API key for the agents.
ANTHROPIC_API_KEY=
# AgentMail API key. Badger sends and reads email through it.
AGENTMAIL_API_KEY=

# --- Optional services ---

# Exa API key. Without it, no web research runs, so cases have no cited policies or contact lookup.
EXA_API_KEY=
# Kernel API key. Without it, "use our web form" replies cannot be handled by filling the form.
KERNEL_API_KEY=
# Inbox Badger sends from. Set this to an inbox you own in AgentMail.
# AGENTMAIL_INBOX=askbadger@agentmail.to
# Webhook signing secret. Registered and filled in automatically at boot when PUBLIC_URL is https.
AGENTMAIL_WEBHOOK_SECRET=
# Public base URL of the server. Must be https and reachable for webhooks and the Kernel browser step.
# PUBLIC_URL=http://localhost:8080
# Port the server listens on.
# PORT=8080
# Read by src/env.ts but not used by any route yet.
ADMIN_SECRET=

# --- Sandbox inboxes (the fictional cast in the demo scenarios) ---

# Gym front desk.
# SIM_GYM_INBOX=sunnyside-gym@agentmail.to
# Roommate.
# SIM_ROOMMATE_INBOX=alex-roommate@agentmail.to
# Landlord.
# SIM_LANDLORD_INBOX=oakview-property@agentmail.to
# First parent in the teacher roster demo.
# SIM_PARENT_LEE_INBOX=piano-parent-lee@agentmail.to
# Second parent in the teacher roster demo.
# SIM_PARENT_ORTIZ_INBOX=piano-parent-ortiz@agentmail.to

# --- Chat apps (each one switches on only when its credentials are set) ---

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Webhook secret header for Telegram. Defaults to the first 32 characters of SESSION_SECRET.
# TELEGRAM_WEBHOOK_SECRET=
# Telegram API base URL. Override only to point tests at a mock.
# TELEGRAM_API_BASE=https://api.telegram.org
# Slack bot token (xoxb-...).
SLACK_BOT_TOKEN=
# Slack signing secret, used to verify incoming requests.
SLACK_SIGNING_SECRET=
# Twilio account SID, for WhatsApp.
TWILIO_ACCOUNT_SID=
# Twilio auth token, also used to verify incoming requests.
TWILIO_AUTH_TOKEN=
# WhatsApp sender, for example whatsapp:+14155238886 (the Twilio sandbox number).
TWILIO_WHATSAPP_FROM=

# --- Behavior ---

# Kill switch. Set to false and Badger drafts and plans but sends nothing.
# SENDING_ENABLED=true
# Sandbox clock speed: one demo day lasts 24 hours divided by this. 4320 means 1 day = 20 seconds.
# DEMO_CLOCK_SCALE=4320
# Model for intake, planning and drafting.
# MODEL_SMART=anthropic/claude-sonnet-5-5
# Model for reply classification and the sandbox characters.
# MODEL_FAST=anthropic/claude-haiku-4-5
# Set to production on a deployed host (secure cookies, signed webhooks required). Leave unset locally.
# NODE_ENV=production
