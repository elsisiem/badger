{
  "name": "badger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The agent that nags so you don't have to.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "build:chat": "vite build -c vite.chat.config.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.130",
    "@anthropic-ai/sdk": "^0.131.0",
    "@assistant-ui/react": "^0.15.23",
    "@assistant-ui/react-ai-sdk": "^1.4.14",
    "@hono/node-server": "^2.1.3",
    "@mastra/ai-sdk": "^1.10.6",
    "@mastra/core": "^1.74.0",
    "@mastra/pg": "^1.29.0",
    "@onkernel/sdk": "^0.119.0",
    "agentmail": "^0.5.35",
    "ai": "^7.0.127",
    "exa-js": "^2.25.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "playwright-core": "^1.63.0",
    "svix": "^1.99.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "node": "^22.23.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
